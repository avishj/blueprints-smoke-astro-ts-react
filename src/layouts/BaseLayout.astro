---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "blueprints-smoke-astro-ts-react",
  description = "A modern Astro + React application.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
